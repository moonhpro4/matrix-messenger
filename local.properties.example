# Copy this file to local.properties (which is gitignored) and fill in your real values.
# local.properties is never committed to git.
#
# Cloudflare credentials are no longer needed here — the app talks to
# our Cloudflare Worker proxy instead, which holds the KV binding
# server-side. Only Gmail's App Password is still needed directly.

GMAIL_APP_PASSWORD=your_gmail_app_password_here
